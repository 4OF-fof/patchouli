      { "label": "棒グラフ", "keys": "bars chart graph bou", "insert": "```bars\n$0\n```" },
      { "label": "数える表", "icon": "plus", "keys": "tally count kazoeru", "insert": "```tally\n$0\n```" }
    ]
  }
}
