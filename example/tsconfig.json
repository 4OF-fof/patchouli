{
  "compilerOptions": {
    "tsBuildInfoFile": "../app/node_modules/.tmp/tsconfig.example.tsbuildinfo",
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": [],
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "paths": { "@patchouli/plugin": ["../app/plugins/sdk/index.ts"] }
  },
  "include": ["*-plugin/**/*.ts"],
  "exclude": ["*-plugin/dist", "*-plugin/target"]
}
