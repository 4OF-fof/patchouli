/// 版は semver で上げる。足すだけの変更はパッチ版、壊す変更は 0.x のマイナー版を上げる。
/// アプリは、同じマイナー版で、アプリの版以下のものを読む。版を上げたら src-tauri/src/plugin/runtime.rs の WIT_VERSION も合わせる。
package patchouli:plugin@0.13.0;

interface types {
  /// アプリが渡すファイル。中身はホストの関数を通して読む。
  record file {
    /// この呼び出しの中だけで使える番号。
    handle: u32,
    /// 拡張子（小文字）。
    ext: string,
    /// 大きさ（バイト）。
    size: u64,
  }

  /// 見た目の大きさ（px）。
  record dimensions {
    width: u32,
    height: u32,
  }

  /// host の fetch で取ってきたもの。url はリダイレクトをたどったあとのもの。
  record fetched {
    status: u16,
    url: string,
    content-type: option<string>,
    body: list<u8>,
  }

  /// できたサムネイル。
  record thumbnail-image {
    /// 長いほうの辺が edge 以下の PNG。
    png: list<u8>,
    /// 素材そのものの大きさ。わからなければ none（サムネイルの縦横比を使う）。
    size: option<dimensions>,
  }

  /// ノートのコードブロックを描いたもの。本文の幅を超えるときは、縮めて出す。
  variant code-image {
    /// SVG の文書。アプリが script・アニメーション・イベントの属性・外への参照を取り除き、本体の画面と切り離して出す。
    /// アプリの CSS 変数（--ink など）を使える。
    svg(string),
    /// PNG。
    png(list<u8>),
  }

  /// ファイルの詳細に足す 1 行。
  record detail {
    label: string,
    value: string,
  }

  /// 右クリックメニューを開いたものや、取り込んだもの 1 つ。format は拡張子（ノートなら md）。
  record target {
    format: string,
    file: file,
  }

  /// run-menu の結果の出し方。
  variant menu-output {
    none,
    /// 短い知らせ。終わったことを伝えるときなど。
    toast(toast),
    /// 行の並びを画面に重ねて見せる。行ごとに値をコピーできる。
    overlay(overlay),
    /// plugin.json の screens の id の画面を開く。画面には targets を渡す。
    screen(string),
  }

  record toast {
    text: string,
    level: toast-level,
  }

  /// 知らせの重要度。色が変わる。info と success は 4 秒で消え、warning と error は閉じるまで残る。
  enum toast-level {
    info,
    success,
    warning,
    error,
  }

  record overlay {
    title: option<string>,
    rows: list<detail>,
  }

  /// ライブラリが持つ、素材やノートの情報。
  record item-info {
    id: string,
    name: string,
    note: bool,
    project: option<string>,
    tags: list<string>,
    memo: string,
  }

  /// embed の similar で見つけたもの。score は内積で、大きいほど近い。
  record similar-item {
    info: item-info,
    score: f32,
  }

  /// 右クリックメニューに足す項目。
  record menu-item {
    /// 選ばれたときに run-menu に渡す。
    id: string,
    label: string,
  }

  record number-range {
    min: option<f64>,
    max: option<f64>,
    step: option<f64>,
  }

  record choice {
    value: string,
    label: string,
  }

  variant setting-kind {
    toggle,
    number(number-range),
    text,
    /// 選んだものの value を text で持つ。
    choice(list<choice>),
  }

  variant setting-value {
    toggle(bool),
    number(f64),
    text(string),
  }

  /// 設定の項目。アプリの部品が描き、値はライブラリに残す。
  record setting {
    key: string,
    label: string,
    /// 項目の下に添える説明。
    help: option<string>,
    kind: setting-kind,
    default: setting-value,
  }

  /// excerpt に渡す上限。
  record excerpt-budget {
    /// 画像の区間の数。
    max-image-parts: u32,
    /// 音声の区間の数。
    max-audio-parts: u32,
    /// 文章の区間の数。
    max-text-parts: u32,
    /// 1 つの区間に入れる画像の数。
    max-images: u32,
    /// 画像の長いほうの辺（px）。
    edge: u32,
    /// 1 つの区間の音声の長さ（秒）。
    max-audio-secs: f64,
  }

  variant excerpt-media {
    /// PNG か JPEG。複数あれば、まとめて 1 つの区間として読む。
    images(list<list<u8>>),
    /// WAV。
    audio(list<u8>),
    text(string),
  }

  /// 内容で探したり分けたりするときに、アプリが読む区間。
  record excerpt-part {
    /// 区間の始まりと終わり（秒）。素材全体なら none。
    start: option<f64>,
    end: option<f64>,
    media: excerpt-media,
  }

  /// menu・run-menu・added の呼び出しの中だけで渡る証明。library・embed の関数に渡す。
  resource read;

  /// run-menu・added の呼び出しの中だけで渡る証明。clipboard・notes・edit・assets・export の関数に渡す。
  resource run;
}

/// アプリが用意する処理。重い処理はここに任せる。
interface host {
  use types.{file, dimensions, setting-value, fetched};

  /// 中身を offset から最大 len バイト読む。
  read: func(f: file, offset: u64, len: u32) -> result<list<u8>, string>;

  /// 画像の見た目の大きさ。写真の向き（EXIF）を反映する。
  image-size: func(f: file) -> option<dimensions>;

  /// 画像を、長いほうの辺が edge 以下になるよう縮めた PNG。アプリが読める形式だけ。
  image-thumbnail: func(f: file, edge: u32) -> result<list<u8>, string>;

  /// 自分の設定の値。変えていなければ settings で返した既定の値。知らない key は none。
  setting: func(key: string) -> option<setting-value>;

  /// 自分で残した値。ライブラリごとに残る。ないときは none。
  get-data: func(key: string) -> option<string>;

  /// 値を残す。none なら消す。
  set-data: func(key: string, value: option<string>) -> result<_, string>;

  /// url を GET で取ってくる（16 MB まで）。行けるのは plugin.json の fetch に書いたホストだけで、リダイレクトの行き先も同じ。
  fetch: func(url: string) -> result<fetched, string>;

  log: func(message: string);
}

/// 手元のコマンドを動かす。plugin.json の required / optional に commands を書いたときだけ使え、
/// そこに書いたコマンドだけを動かせる。
interface commands {
  use types.{file};

  /// コマンドに渡す引数。file は、そのファイルの場所に置き換えて渡す。
  variant command-arg {
    text(string),
    file(file),
  }

  /// コマンドが終わったときの結果。
  record command-output {
    /// 終わったときの番号。止めたときなどは none。
    code: option<s32>,
    stdout: list<u8>,
    stderr: string,
  }

  /// コマンドが見つかり、版の下限を満たすか。
  available: func(name: string) -> bool;

  /// 標準入力は空にし、timeout-ms（none なら 30 秒）で終わらなければ止める。長さに上限はない。
  run: func(name: string, args: list<command-arg>, timeout-ms: option<u32>) -> result<command-output, string>;
}

/// ライブラリの情報を読む。plugin.json の permissions に library を書いたときだけ使える。
interface library {
  use types.{file, item-info, read};

  /// f は targets のファイル。
  item: func(ctx: borrow<read>, f: file) -> result<item-info, string>;
}

/// クリップボードに写す。plugin.json の permissions に clipboard を書いたときだけ使える。
/// 写すのは run-menu が終わったときで、失敗を返したときは写さない。added の中では使えない。
interface clipboard {
  use types.{run};

  copy: func(ctx: borrow<run>, text: string);
}

/// ノートを作ったり、本文を書き換えたりする。plugin.json の permissions に notes を書いたときだけ使える。
/// 書くのは run-menu・added が終わったときで、失敗を返したときは書かない。
interface notes {
  use types.{file, run};

  /// 置き場は、targets の先頭と同じ。
  create: func(ctx: borrow<run>, name: string, body: string) -> result<_, string>;

  /// f は targets のノート。body は本文で、先頭のメタ情報（---）は含めない。
  set-body: func(ctx: borrow<run>, f: file, body: string) -> result<_, string>;
}

/// 素材やノートの名前とタグを変える。plugin.json の permissions に edit を書いたときだけ使える。
/// 変えるのは run-menu・added が終わったときで、失敗を返したときは変えない。f は targets のファイル。
interface edit {
  use types.{file, run};

  /// name は拡張子を除いた名前。
  rename: func(ctx: borrow<run>, f: file, name: string) -> result<_, string>;

  /// タグをすべて tags に置き換える。
  set-tags: func(ctx: borrow<run>, f: file, tags: list<string>) -> result<_, string>;
}

/// 素材を登録したり、中身を置き換えたりする。plugin.json の permissions に assets を書いたときだけ使える。
/// 登録や置き換えは run-menu・added が終わったときで、失敗を返したときはしない。
interface assets {
  use types.{file, run};

  /// 書き込み用の空のファイルを用意する。name は拡張子を含めた名前。
  /// commands の run の引数に渡してコマンドに書かせるか、write で書く。host の read でも読める。
  create: func(ctx: borrow<run>, name: string) -> result<file, string>;

  /// create で用意したファイルの終わりに足す。
  write: func(ctx: borrow<run>, f: file, data: list<u8>) -> result<_, string>;

  /// create で用意したファイルを素材として登録する。name を渡すと、その名前（拡張子を除く）にする。
  /// 置き場は、targets の先頭と同じ。
  add: func(ctx: borrow<run>, f: file, name: option<string>) -> result<_, string>;

  /// targets の素材 target の中身を、create で用意したファイル source に置き換える。拡張子は source に合わせて変わる。
  /// 元のファイルは残さない。名前・タグ・メモはそのまま。
  replace: func(ctx: borrow<run>, target: file, source: file) -> result<_, string>;
}

/// ライブラリの外へファイルを書き出す。plugin.json の permissions に export を書いたときだけ使える。
/// run-menu が終わったときに、アプリが保存先を聞いて書き出す。失敗を返したときは書き出さない。added の中では使えない。
interface %export {
  use types.{file, run};

  /// 書き出すファイルを用意する。name は拡張子を含めた名前で、保存先を聞くときの既定の名前にする。
  /// 1 回の run-menu で用意できるのは 1 つだけ。複数を書き出すときは zip などにまとめる。
  /// commands の run の引数に渡してコマンドに書かせるか、write で書く。
  create: func(ctx: borrow<run>, name: string) -> result<file, string>;

  /// create で用意したファイルの終わりに足す。
  write: func(ctx: borrow<run>, f: file, data: list<u8>) -> result<_, string>;
}

/// EmbeddingGemma で文章をベクトルにする。plugin.json の permissions に embed を書いたときだけ使える。
/// 使えるのは、AI 機能を有効にしてモデルを入れたときだけ。
interface embed {
  use types.{read, similar-item};

  /// いま使えるか。
  available: func() -> bool;

  /// 長さ 1 のベクトル。2 つの内積が大きいほど近い。
  text: func(ctx: borrow<read>, s: string) -> result<list<f32>, string>;

  /// ライブラリの素材とノートから、s に近いものを近い順に最大 limit 件。
  /// 内容での検索と同じ索引を使うので、索引をまだ作っていないものは出ない。
  similar: func(ctx: borrow<read>, s: string, limit: u32) -> result<list<similar-item>, string>;
}

/// 役割ごとに export する interface。プラグインは、受け持つ役割の world（下の *-role）を include でまとめた world を作る。
/// plugin.json の formats の parts のうち、script に書いていないものを受け持つ interface を export する。

/// サムネイル。
interface thumbnail {
  use types.{file, thumbnail-image};

  /// 作らないときは none。format は拡張子（小文字）。
  thumbnail: func(format: string, f: file, edge: u32) -> result<option<thumbnail-image>, string>;
}

/// 詳細の表示。アプリが読めない画像を PNG にし、アプリが画像として出す。
interface view {
  use types.{file};

  /// 詳細に出す PNG（素材そのものの大きさ）。
  decode: func(format: string, f: file) -> result<list<u8>, string>;
}

/// ファイルの詳細に足す行。
interface details {
  use types.{file, detail};

  /// 詳細を開くたびに呼ぶ。
  details: func(format: string, f: file) -> result<list<detail>, string>;
}

/// 内容で探したり分けたりするときに読む区間。
interface excerpt {
  use types.{file, excerpt-budget, excerpt-part};

  /// 区間の分け方はプラグインが決め、budget を超えない。空なら、アプリがサムネイルを読む。
  excerpt: func(format: string, f: file, budget: excerpt-budget) -> result<list<excerpt-part>, string>;
}

/// 右クリックメニュー。plugin.json の menu を書いたときに使う。
interface menu {
  use types.{target, menu-item, menu-output, read, run};

  /// メニューを開くたびに呼ぶ。targets は選んでいるものすべてで、1 つ以上ある。選んだものがすべて menu の formats に入るときだけ呼ぶ。
  /// 数を見て、1 つのときだけ・複数のときだけの項目を返せる。返した項目は、選んだものすべてにかける。
  menu: func(read: borrow<read>, targets: list<target>) -> result<list<menu-item>, string>;

  /// menu で返した項目が選ばれたとき。targets は menu と同じもの。返したものを、アプリが出し方に合わせて見せる。
  run-menu: func(read: borrow<read>, run: borrow<run>, targets: list<target>, id: string) -> result<menu-output, string>;
}

/// フック。plugin.json の hooks に書いたときに、そこに書いた形式のものを渡す。
interface hook {
  use types.{target, read, run};

  /// フックを呼ぶとき。
  enum hook-event {
    /// 取り込んだとき。右クリックメニューで作ったノートと登録した素材も含む。
    added,
    /// 中身が変わったとき。ノートは書き換えて離れたとき、ファイルはアプリの外で変わったのを見つけたとき。
    changed,
    /// 名前・タグ・置き場を変えたとき。
    edited,
  }

  /// 1 つごとに、裏で呼ぶ。同じ形式のフックが複数あれば、プラグインの一覧の順に呼び、
  /// 前のフックが書き換えたあとのものを渡す。フックの中で書き換えたものには、フックを呼ばない。
  hook: func(read: borrow<read>, run: borrow<run>, event: hook-event, target: target) -> result<_, string>;
}

/// ノートのコードブロック。plugin.json の notes の code のうち、script に書いていないものを描く。
interface code {
  use types.{code-image};

  /// lang は ``` の後ろに書いた言語（小文字）、source は中身（囲みの ``` の行を除いたもの）。
  /// 中身が変わるたびに呼ぶ。
  render: func(lang: string, source: string) -> result<code-image, string>;
}

/// 設定の項目。
interface settings {
  use types.{setting};

  /// ライブラリを開いたときに一度だけ呼ぶ。
  settings: func() -> list<setting>;
}

/// スクリプト（plugin.json の script）から呼ばれる関数。
interface call {
  use types.{file};

  /// method と args（JSON など）の中身はプラグインが決める。
  call: func(format: string, f: file, method: string, args: string) -> result<string, string>;
}

/// どの world も読めるもの。使わないものは、ビルドした WASM に入らない。
world imports {
  import host;
  import commands;
  import library;
  import clipboard;
  import notes;
  import edit;
  import assets;
  import %export;
  import embed;
}

world thumbnail-role {
  include imports;
  export thumbnail;
}

world view-role {
  include imports;
  export view;
}

world details-role {
  include imports;
  export details;
}

world excerpt-role {
  include imports;
  export excerpt;
}

world menu-role {
  include imports;
  export menu;
}

world hook-role {
  include imports;
  export hook;
}

world code-role {
  include imports;
  export code;
}

world settings-role {
  include imports;
  export settings;
}

world call-role {
  include imports;
  export call;
}

/// すべての役割。アプリが使う。
world full {
  include thumbnail-role;
  include view-role;
  include details-role;
  include excerpt-role;
  include menu-role;
  include hook-role;
  include code-role;
  include settings-role;
  include call-role;
}
