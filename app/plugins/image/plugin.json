{
  "id": "patchouli.image",
  "name": "画像",
  "version": "0.3.0",
  "description": "写真やイラストのサムネイルと表示",
  "optional": {
    "commands": {
      "ffmpeg": { "version": { "args": ["-version"], "pattern": "ffmpeg version n?([0-9][^ ]*)" } }
    }
  },
  "formats": {
    "jpg": { "label": "画像", "ratio": 1.6, "parts": ["thumbnail", "view", "details"] },
    "jpeg": { "extends": "jpg" },
    "png": { "extends": "jpg" },
    "webp": { "extends": "jpg" },
    "gif": { "extends": "jpg" },
    "avif": { "extends": "jpg" },
    "bmp": { "extends": "jpg" }
  }
}
