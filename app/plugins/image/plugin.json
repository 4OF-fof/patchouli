{
  "id": "patchouli.image",
  "name": "画像",
  "version": "0.4.0",
  "description": "写真やイラストのサムネイルと表示",
  "optional": {
    "commands": {
      "ffmpeg": {
        "version": { "args": ["-version"], "pattern": "ffmpeg version n?([0-9][^ ]*)" },
        "description": "本体で読めない画像の、サムネイルと内容の読み取りに使います"
      }
    }
  },
  "formats": {
    "jpg": { "label": "画像", "ratio": 1.6, "sandbox": ["thumbnail", "view", "details", "content"] },
    "jpeg": { "extends": "jpg" },
    "png": { "extends": "jpg" },
    "webp": { "extends": "jpg" },
    "gif": { "extends": "jpg" },
    "avif": { "extends": "jpg" },
    "bmp": { "extends": "jpg" }
  }
}
