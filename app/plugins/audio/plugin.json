{
  "id": "patchouli.audio",
  "name": "音声",
  "version": "0.6.0",
  "description": "音声のジャケットと波形、再生、長さと BPM",
  "script": "ui/waveform.js",
  "optional": {
    "commands": {
      "ffmpeg": {
        "version": { "args": ["-version"], "pattern": "ffmpeg version n?([0-9][^ ]*)" },
        "description": "本体で読めない符号化の MP3・WAV・FLAC も、AI 機能で読み取れるようになります"
      }
    }
  },
  "formats": [
    {
      "ext": ["mp3", "wav", "flac"],
      "label": "音声",
      "ratio": 1.6,
      "media": "audio",
      "parts": ["thumbnail", "details", "excerpt", "waveform"],
      "script": ["waveform"]
    }
  ]
}
