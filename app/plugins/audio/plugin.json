{
  "id": "patchouli.audio",
  "name": "音声",
  "version": "0.5.0",
  "description": "音声のジャケットと波形、再生、長さと BPM",
  "elevated": "ui/waveform.js",
  "optional": {
    "commands": {
      "ffmpeg": {
        "version": { "args": ["-version"], "pattern": "ffmpeg version n?([0-9][^ ]*)" },
        "description": "本体で読めない符号化の MP3・WAV・FLAC も、AI 機能で読み取れるようになります"
      }
    }
  },
  "formats": {
    "mp3": {
      "label": "音声",
      "ratio": 1.6,
      "sandbox": ["thumbnail", "view", "details", "content"],
      "elevated": ["waveform"]
    },
    "wav": { "extends": "mp3" },
    "flac": { "extends": "mp3" }
  }
}
