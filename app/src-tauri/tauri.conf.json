{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Patchouli",
  "version": "../package.json",
  "identifier": "dev.4of.patchouli",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "node ../scripts/licenses.ts && pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Patchouli",
        "width": 800,
        "height": 600,
        "backgroundColor": "#1f1f1f",
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
