/// 版は semver で上げる。足すだけの変更はパッチ版、壊す変更は 0.x のマイナー版を上げる。
/// アプリは、同じマイナー版で、アプリの版以下のものを読む。版を上げたら src-tauri/src/plugin/runtime.rs の WIT_VERSION も合わせる。
package patchouli:plugin@0.11.0;

interface types {
  /// アプリが渡すファイル。中身はホストの関数を通して読む。
  record file {
    /// この呼び出しの中だけで使える番号。
    handle: u32,
    /// 拡張子（小文字）。
    ext: string,
    /// 大きさ（バイト）。
    size: u64,
  }

  /// 見た目の大きさ（px）。
  record dimensions {
    width: u32,
    height: u32,
  }

  /// できたサムネイル。
  record thumbnail-image {
    /// 長いほうの辺が edge 以下の PNG。
    png: list<u8>,
    /// 素材そのものの大きさ。わからなければ none（サムネイルの縦横比を使う）。
    size: option<dimensions>,
  }

  /// 素材の詳細に出すもの。
  variant view-kind {
    /// アプリが画像として出す。
    image,
    /// アプリが動画として出す。サムネイルを最初の絵にする。
    video,
    /// アプリが音声として出す。サムネイルをジャケットにする。
    audio,
    /// アプリが読めない画像。decode で PNG にしたものを、アプリが画像として出す。
    decoded,
  }

  /// ファイルの詳細に足す 1 行。
  record detail {
    label: string,
    value: string,
  }

  /// 右クリックメニューを開いたもの 1 つ。format は拡張子（ノートなら md）。
  record target {
    format: string,
    file: file,
  }

  /// run-menu の結果の出し方。
  variant menu-output {
    none,
    /// 短い知らせ。終わったことを伝えるときなど。
    toast(string),
    /// 行の並びを画面に重ねて見せる。行ごとに値をコピーできる。
    overlay(overlay),
  }

  record overlay {
    title: option<string>,
    rows: list<detail>,
  }

  /// ライブラリが持つ、素材やノートの情報。
  record item-info {
    id: string,
    name: string,
    note: bool,
    project: option<string>,
    tags: list<string>,
    memo: string,
  }

  /// 右クリックメニューに足す項目。
  record menu-item {
    /// 選ばれたときに run-menu に渡す。
    id: string,
    label: string,
  }

  record number-range {
    min: option<f64>,
    max: option<f64>,
    step: option<f64>,
  }

  record choice {
    value: string,
    label: string,
  }

  variant setting-kind {
    toggle,
    number(number-range),
    text,
    /// 選んだものの value を text で持つ。
    choice(list<choice>),
  }

  variant setting-value {
    toggle(bool),
    number(f64),
    text(string),
  }

  /// 設定の項目。アプリの部品が描き、値はライブラリに残す。
  record setting {
    key: string,
    label: string,
    /// 項目の下に添える説明。
    help: option<string>,
    kind: setting-kind,
    default: setting-value,
  }

  /// content に渡す上限。
  record content-budget {
    /// 画像の区間の数。
    max-image-parts: u32,
    /// 音声の区間の数。
    max-audio-parts: u32,
    /// 文章の区間の数。
    max-text-parts: u32,
    /// 1 つの区間に入れる画像の数。
    max-images: u32,
    /// 画像の長いほうの辺（px）。
    edge: u32,
    /// 1 つの区間の音声の長さ（秒）。
    max-audio-secs: f64,
  }

  variant content-media {
    /// PNG か JPEG。複数あれば、まとめて 1 つの区間として読む。
    images(list<list<u8>>),
    /// WAV。
    audio(list<u8>),
    text(string),
  }

  /// 内容で探したり分けたりするときに、アプリが読む区間。
  record content-part {
    /// 区間の始まりと終わり（秒）。素材全体なら none。
    start: option<f64>,
    end: option<f64>,
    media: content-media,
  }

  /// menu と run-menu の呼び出しの中だけで渡る証明。library の関数に渡す。
  resource menu-read;

  /// run-menu の呼び出しの中だけで渡る証明。clipboard・notes・assets の関数に渡す。
  resource menu-run;
}

/// アプリが用意する処理。重い処理はここに任せる。
interface host {
  use types.{file, dimensions, setting-value};

  /// 中身を offset から最大 len バイト読む。
  read: func(f: file, offset: u64, len: u32) -> result<list<u8>, string>;

  /// 画像の見た目の大きさ。写真の向き（EXIF）を反映する。
  image-size: func(f: file) -> option<dimensions>;

  /// 画像を、長いほうの辺が edge 以下になるよう縮めた PNG。アプリが読める形式だけ。
  image-thumbnail: func(f: file, edge: u32) -> result<list<u8>, string>;

  /// 自分の設定の値。変えていなければ settings で返した既定の値。知らない key は none。
  setting: func(key: string) -> option<setting-value>;

  /// 自分で残した値。ライブラリごとに残る。ないときは none。
  get-data: func(key: string) -> option<string>;

  /// 値を残す。none なら消す。
  set-data: func(key: string, value: option<string>) -> result<_, string>;

  log: func(message: string);
}

/// 手元のコマンドを動かす。plugin.json の required / optional に commands を書いたときだけ使え、
/// そこに書いたコマンドだけを動かせる。
interface commands {
  use types.{file};

  /// コマンドに渡す引数。file は、そのファイルの場所に置き換えて渡す。
  variant command-arg {
    text(string),
    file(file),
  }

  /// コマンドが終わったときの結果。
  record command-output {
    /// 終わったときの番号。止めたときなどは none。
    code: option<s32>,
    stdout: list<u8>,
    stderr: string,
  }

  /// コマンドが見つかり、版の下限を満たすか。
  available: func(name: string) -> bool;

  /// 標準入力は空にし、timeout-ms（none なら 30 秒）で終わらなければ止める。長さに上限はない。
  run: func(name: string, args: list<command-arg>, timeout-ms: option<u32>) -> result<command-output, string>;
}

/// ライブラリの情報を読む。plugin.json の permissions に library を書いたときだけ使える。
interface library {
  use types.{file, item-info, menu-read};

  /// f は targets のファイル。
  item: func(ctx: borrow<menu-read>, f: file) -> result<item-info, string>;
}

/// クリップボードに写す。plugin.json の permissions に clipboard を書いたときだけ使える。
/// 写すのは run-menu が終わったときで、失敗を返したときは写さない。
interface clipboard {
  use types.{menu-run};

  copy: func(ctx: borrow<menu-run>, text: string);
}

/// ノートを作る。plugin.json の permissions に notes を書いたときだけ使える。
/// 作るのは run-menu が終わったときで、失敗を返したときは作らない。置き場は targets の先頭と同じ。
interface notes {
  use types.{menu-run};

  create: func(ctx: borrow<menu-run>, name: string, body: string) -> result<_, string>;
}

/// 素材を登録する。plugin.json の permissions に assets を書いたときだけ使える。
/// 登録するのは run-menu が終わったときで、失敗を返したときは登録しない。置き場は targets の先頭と同じ。
interface assets {
  use types.{file, menu-run};

  /// 書き込み用の空のファイルを用意する。name は拡張子を含めた名前。
  /// commands の run の引数に渡してコマンドに書かせるか、write で書く。host の read でも読める。
  create: func(ctx: borrow<menu-run>, name: string) -> result<file, string>;

  /// create で用意したファイルの終わりに足す。
  write: func(ctx: borrow<menu-run>, f: file, data: list<u8>) -> result<_, string>;

  /// create で用意したファイルを素材として登録する。name を渡すと、その名前（拡張子を除く）にする。
  add: func(ctx: borrow<menu-run>, f: file, name: option<string>) -> result<_, string>;
}

/// 役割ごとに export する interface。プラグインは、受け持つ役割の world（下の *-role）を include でまとめた world を作る。
/// アプリは読み込むときに export を調べ、plugin.json の formats で sandbox を true にした形式に、ある役割を受け持たせる。

/// サムネイル。
interface thumbnail {
  use types.{file, thumbnail-image};

  /// 作らないときは none。format は受け持つ形式（拡張子）。
  thumbnail: func(format: string, f: file, edge: u32) -> result<option<thumbnail-image>, string>;
}

/// 詳細の表示。
interface view {
  use types.{file, view-kind};

  /// 詳細に出すもの。none ならアプリがサムネイルを大きく出す。
  view: func(format: string, f: file) -> option<view-kind>;

  /// view が decoded を返したときに、詳細に出す PNG（素材そのものの大きさ）。
  decode: func(format: string, f: file) -> result<list<u8>, string>;
}

/// ファイルの詳細に足す行。
interface details {
  use types.{file, detail};

  /// 詳細を開くたびに呼ぶ。
  details: func(format: string, f: file) -> result<list<detail>, string>;
}

/// 内容で探したり分けたりするときに読む区間。
interface content {
  use types.{file, content-budget, content-part};

  /// 区間の分け方はプラグインが決め、budget を超えない。空なら、アプリがサムネイルを読む。
  content: func(format: string, f: file, budget: content-budget) -> result<list<content-part>, string>;
}

/// 右クリックメニュー。plugin.json の menu の by を sandbox にしたときに使う。
interface menu {
  use types.{target, menu-item, menu-output, menu-read, menu-run};

  /// メニューを開くたびに呼ぶ。targets は選んでいるものすべてで、1 つ以上ある。選んだものがすべて menu の formats に入るときだけ呼ぶ。
  /// 数を見て、1 つのときだけ・複数のときだけの項目を返せる。返した項目は、選んだものすべてにかける。
  menu: func(read: borrow<menu-read>, targets: list<target>) -> result<list<menu-item>, string>;

  /// menu で返した項目が選ばれたとき。targets は menu と同じもの。返したものを、アプリが出し方に合わせて見せる。
  run-menu: func(read: borrow<menu-read>, run: borrow<menu-run>, targets: list<target>, id: string) -> result<menu-output, string>;
}

/// 設定の項目。
interface settings {
  use types.{setting};

  /// ライブラリを開いたときに一度だけ呼ぶ。
  settings: func() -> list<setting>;
}

/// elevated（plugin.json の elevated）から呼ばれる関数。
interface call {
  use types.{file};

  /// method と args（JSON など）の中身はプラグインが決める。
  call: func(format: string, f: file, method: string, args: string) -> result<string, string>;
}

/// どの world も読めるもの。使わないものは、ビルドした WASM に入らない。
world imports {
  import host;
  import commands;
  import library;
  import clipboard;
  import notes;
  import assets;
}

world thumbnail-role {
  include imports;
  export thumbnail;
}

world view-role {
  include imports;
  export view;
}

world details-role {
  include imports;
  export details;
}

world content-role {
  include imports;
  export content;
}

world menu-role {
  include imports;
  export menu;
}

world settings-role {
  include imports;
  export settings;
}

world call-role {
  include imports;
  export call;
}

/// すべての役割。アプリが使う。
world full {
  include thumbnail-role;
  include view-role;
  include details-role;
  include content-role;
  include menu-role;
  include settings-role;
  include call-role;
}
